@page "/pizzas"

@inject HttpClient Http
@inject IJSRuntime JSRuntime


<PageTitle>Pizzas</PageTitle>

<h3>Pizzas</h3>
@if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (pizzas is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Gluten-free</th>
                <th>Ingredients</th>
                <AuthorizeView Roles="Admin">
                    <th>Actions</th>
                </AuthorizeView>
            </tr>
        </thead>
        <tbody>
            @foreach (PizzaResponseDto pizza in pizzas)
            {
                <tr>
                    <td>@pizza.Name</td>
                    <td>@(pizza.IsGlutenFree ? "Yes" : "No")</td>
                    <td>@(string.Join(", ", pizza.Ingredients))</td>
                    <AuthorizeView Roles="Admin">
                        <td>
                            <button type="button" class="btn btn-danger btn-sm" @onclick="() => DeleteAsync(pizza.Id)">
                                Delete
                            </button>
                        </td>
                    </AuthorizeView>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<PizzaResponseDto>? pizzas;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        pizzas = await Http.GetFromJsonAsync<List<PizzaResponseDto>>("Pizza");
    }

    private async Task DeleteAsync(int id)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this pizza?");
        if (!confirmed) return;

        var response = await Http.DeleteAsync($"Pizza/{id}");
        if (response.IsSuccessStatusCode)
        {
            pizzas?.RemoveAll(eachPizza => eachPizza.Id == id);
            errorMessage = null;
        }
        else
        {
            var message = await response.Content.ReadAsStringAsync();
            errorMessage = string.IsNullOrEmpty(message)
                ? $"Delete failed ({(int)response.StatusCode})."
                : message;
        }
    }
}