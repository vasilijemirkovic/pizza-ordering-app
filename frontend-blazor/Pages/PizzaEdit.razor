@page "/pizzas/new"
@page "/pizzas/edit/{Id:int}"
@attribute [Authorize(Roles = "Admin")]

@inject HttpClient Http
@inject NavigationManager NavigationManager

<PageTitle>@(Id is null ? "Add new pizza" : "Edit pizza")</PageTitle>

<h3> @(Id is null ? "Add new pizza" : "Edit pizza")</h3>

@if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
<EditForm Model="pizzaRequestDto" OnValidSubmit="HandleSubmitAsync">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label>Name</label>
        <InputText @bind-Value="pizzaRequestDto.Name" class="form-control" />
        <ValidationMessage For="() => pizzaRequestDto.Name" />
    </div>

    <div class="mb-3 form-check">
        <InputCheckbox @bind-Value="pizzaRequestDto.IsGlutenFree" class="form-check-input" />
        <label class="form-check-label">Gluten-free</label>
    </div>

    <div class="mb-3">
        <label>Ingredients (comma-separated)</label>
        <InputText @bind-Value="ingredientsText" @bind-Value:after="UpdateIngredients" class="form-control"
                   placeholder="tomato, mozzarella, basil" />
        <ValidationMessage For="() => pizzaRequestDto.Ingredients" />
    </div>

    <button type="submit" class="btn btn-primary">@(Id is null ? "Add" : "Save")</button>
</EditForm>

@code {
    private PizzaRequestDto pizzaRequestDto = new();
    private string ingredientsText = string.Empty;
    private string? errorMessage;
    [Parameter] public int? Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Id is null)
        {
            return;
        }

        var response = await Http.GetAsync($"Pizza/{Id}");
        if (!response.IsSuccessStatusCode)
        {
            errorMessage = "Pizza not found!";
            return;
        }

        var pizza = await response.Content.ReadFromJsonAsync<PizzaResponseDto>();

        pizzaRequestDto = new PizzaRequestDto
        {
            Name = pizza!.Name,
            IsGlutenFree = pizza.IsGlutenFree,
            Ingredients = pizza.Ingredients
        };
        ingredientsText = string.Join(", ", pizza!.Ingredients);
        
    }

    private async Task HandleSubmitAsync()
    {
        errorMessage = null;

        HttpResponseMessage response;

        if (Id is null)
        {
            response = await Http.PostAsJsonAsync("Pizza", pizzaRequestDto);
        }
        else
        {
            response = await Http.PutAsJsonAsync($"Pizza/{Id}", pizzaRequestDto);
        }

        if (response.IsSuccessStatusCode)
        {
            NavigationManager.NavigateTo("/pizzas");
        }
        else
        {
            var message = await response.Content.ReadAsStringAsync();
            errorMessage = string.IsNullOrEmpty(message)
                ? $"Saving failed ({(int)response.StatusCode})."
                : message;
        }
    }
    private void UpdateIngredients()
    {
        pizzaRequestDto.Ingredients = ingredientsText.Split(',', StringSplitOptions.RemoveEmptyEntries |
StringSplitOptions.TrimEntries).ToList();
    }
}