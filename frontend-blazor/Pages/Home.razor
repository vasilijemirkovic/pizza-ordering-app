@page "/"

<PageTitle>Pizza Ordering App</PageTitle>

<h1>Welcome to Pizza Ordering App</h1>

<p>Browse our pizza menu. Administrators can add, edit and delete pizzas..</p>

<AuthorizeView>
    <Authorized>
        <div>
            <p>Welcome back @context.User.Identity?.Name!</p>
            <a class="btn btn-primary" href="/pizzas">Browse pizzas</a>
        </div>
    </Authorized>
    <NotAuthorized>
        <a class="btn btn-primary me-2" href="/register">Register</a>
        <a class="btn btn-outline-primary" href="/login">Login</a>
    </NotAuthorized>
</AuthorizeView>